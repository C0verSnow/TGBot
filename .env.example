# 示例文件，不会自动加载。真实值填到下述网站设置中，不提交 .env。
# Vercel Production 环境变量
TELEGRAM_BOT_TOKEN=123456789:EXAMPLE_NOT_A_REAL_TOKEN
TELEGRAM_WEBHOOK_SECRET=replace_with_random_64_character_hex_string
GITHUB_REPOSITORY=C0verSnow/TGBot
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=github_pat_EXAMPLE_NOT_A_REAL_TOKEN

# GitHub bot-control 环境 Secrets
# TELEGRAM_BOT_TOKEN 同上
TS_OAUTH_CLIENT_ID=example-client-id
TS_OAUTH_SECRET=tskey-client-EXAMPLE
SSH_HOST=100.101.102.103
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\nEXAMPLE\n-----END OPENSSH PRIVATE KEY-----"
SSH_KNOWN_HOSTS="100.101.102.103 ssh-ed25519 AAAA_EXAMPLE"

# 远程服务器的 SSH 强制命令环境变量（不填 Vercel）
DOCKER_CONTAINER=my-container

# GitHub production 环境 Secrets
VERCEL_TOKEN=example-vercel-token
# TELEGRAM_BOT_TOKEN、TELEGRAM_WEBHOOK_SECRET 同 Vercel

# GitHub production 环境 Variables
VERCEL_ORG_ID=team_example
VERCEL_PROJECT_ID=prj_example
VERCEL_CLI_VERSION=REPLACE_WITH_REVIEWED_EXACT_VERSION
WEBHOOK_URL=https://your-project.vercel.app/webhook

# Go 迁移：Vercel Preview 环境（验收完成后再复制到 Production）
# TELEGRAM_BOT_TOKEN、TELEGRAM_WEBHOOK_SECRET 同上
# SSH_HOST、SSH_PRIVATE_KEY、SSH_KNOWN_HOSTS 同上，私钥保留真实换行
# 本次 Go 版选用 TS_AUTHKEY：可重复使用、ephemeral、预批准并带 tag:tgbot-ci
TS_AUTHKEY=tskey-auth-EXAMPLE
# 不要把旧 Actions 使用的 TS_OAUTH_SECRET 同时复制到 Go 环境
TSNET_PROBE_SECRET=replace_with_a_separate_random_64_character_hex_string
# OAuth 仍是备选；切换时先移除 TS_AUTHKEY，两种方式只选一种
TS_NO_LOGS_NO_SUPPORT=true
# 验收后 WEBHOOK_URL 改为 https://your-project.vercel.app/webhook-go

# /updatesecret：Vercel 服务端变量；值来自现有安全配置，不填到聊天或 Git。
INFISICAL_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=your-machine-client-id
INFISICAL_CLIENT_SECRET=your-machine-client-secret
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/
# 新增两项，来自同一个 Upstash Redis 数据库的 REST API 页面。
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-write-capable-rest-token
