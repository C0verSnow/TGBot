{
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "internal/allowlist/idlist.md"
    },
    "api/go.go": {
      "maxDuration": 60
    },
    "api/probe.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/index"
    },
    {
      "source": "/webhook-go",
      "destination": "/api/go"
    },
    {
      "source": "/tsnet-probe",
      "destination": "/api/probe"
    }
  ]
}
